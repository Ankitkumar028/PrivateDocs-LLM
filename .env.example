# ==============================================================================
# PrivateDocs-LLM Configuration (.env.example)
# Copy this file to .env and adjust values for your environment.
# Never commit .env with real secrets to version control.
# ==============================================================================

# --- Environment ---
ENVIRONMENT=local                  # local | droplet | test
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR

# --- LLM Serving (OpenAI-compatible HTTP endpoint) ---
# Local dev: Ollama (http://localhost:11434/v1) or llama.cpp / mock server (http://localhost:8080/v1)
# Droplet: vLLM ROCm container (http://localhost:8000/v1)
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=local-dev-key
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# --- Embeddings (CPU-only sentence-transformers) ---
# VERIFY: BAAI/bge-small-en-v1.5 is fast, high quality, and runs cleanly on CPU
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# --- Vector Database (Qdrant) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=private_documents
QDRANT_IN_MEMORY=false

# --- Ingestion & Chunking ---
CHUNKING_STRATEGY=fixed            # fixed | recursive | sentence_window
CHUNK_SIZE=400                     # Default 400 tokens / words
CHUNK_OVERLAP=50                   # Default 50 tokens / words overlap

# --- Retrieval ---
RETRIEVAL_MODE=hybrid              # dense | bm25 | hybrid
TOP_K=5
RRF_K=60                           # Reciprocal Rank Fusion constant
RERANK_ENABLED=false               # Feature flag for cross-encoder reranking
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- FastAPI Gateway ---
API_HOST=0.0.0.0
API_PORT=8000
API_KEYS_DB_PATH=data/auth_keys.db
RATE_LIMIT_PER_MINUTE=60
ADMIN_API_KEY=admin-secret-dev-key-change-in-prod
USER_API_KEY=user-secret-dev-key-change-in-prod

# --- Streamlit UI ---
STREAMLIT_PORT=8501
API_BASE_URL=http://localhost:8000

# --- Droplet & GPU (AMD MI300X) ---
# VERIFY current image tag and launch flags in AMD ROCm/vLLM docs before deploying
VLLM_IMAGE=rocm/vllm:rocm6.2_mi300_ubuntu22.04_py3.10_vllm_0.6.3
HF_TOKEN=
HF_HUB_ENABLE_HF_TRANSFER=1
GPU_HOURLY_RATE=1.99
GPU_MAX_BUDGET_HOURS=35.0

# --- SEC EDGAR Ingestion ---
SEC_USER_AGENT="PrivateDocs-LLM-Evaluation/1.0 (admin@example.com; Research-RAG-Evaluation)"

