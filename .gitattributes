# Auto-detect text files and normalize line endings
* text=auto

# Force LF endings for all shell scripts and Unix scripts
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
Makefile text eol=lf

# Force CRLF or native for Windows batch / PowerShell
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.db binary
*.pkl binary
